{
  "expo": {
    "name": "TailorBook",
    "slug": "tailorbook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4B3FA0"
    },
    "web": {
      "bundler": "webpack",
      "output": "single"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4B3FA0"
      },
      "package": "com.tailorbook.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tailorbook.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "TailorBook needs camera access to photograph outfit samples.",
        "NSPhotoLibraryUsageDescription": "TailorBook needs photo library access to select outfit sample images.",
        "NSContactsUsageDescription": "TailorBook uses your contacts to quickly add customer phone numbers."
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4B3FA0",
          "defaultChannel": "job-reminders",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TailorBook needs access to your photos to add outfit samples."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8c8e886b-e461-43e8-a4c8-83cae3e35eb8"
      }
    }
  }
}
