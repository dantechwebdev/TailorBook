# TailorBook Website Environment Variables
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.

# URL to the Android APK download (e.g. Google Drive, GitHub Releases, or your CDN)
VITE_APK_DOWNLOAD_URL=https://your-cdn.com/tailorbook.apk

# URL to the Founding Member sign-up form (e.g. Google Forms, Typeform, or Tally)
VITE_FOUNDING_MEMBER_URL=https://forms.google.com/your-form-id

# Contact email address shown in the footer
VITE_CONTACT_EMAIL=hello@tailorbook.app

# Optional: Analytics / tracking ID
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
